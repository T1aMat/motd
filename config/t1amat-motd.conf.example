# T1aMat MOTD configuration
# Installed to /etc/t1amat-motd.conf on first install.
# This file is preserved across MOTD updates.
#
# MOTD_ORDER contains ALL MOTD lines in their permanent display order.
# MOTD_DISABLED contains lines that are currently hidden.
# This lets you disable/re-enable a line without changing its position.
#
# Example:
#   MOTD_ORDER=( uptime memory disk-usage services last-login ... )
#   MOTD_DISABLED=( docker logins )

MOTD_HEADER="T1aMat"

MOTD_ORDER=(
    last-login
    uptime
    load-average
    memory
    disk-usage
    logins
    processes
    services
    docker
)

# Empty by default. Remove a module from the MOTD without losing its position.
MOTD_DISABLED=()

# Services shown by 09-services.
# The installer can auto-discover installed services and let you select them.
MOTD_SERVICES=(
    ssh
    ufw
    docker
    nginx
)

MOTD_DISKS=(
    /
)

WARN_PCT=80
CRIT_PCT=90

# 0 = automatically fit the current terminal width.
SERVICES_WIDTH=0

DOCKER_TIMEOUT=3
SSH_LOGIN_LOOKBACK=200
