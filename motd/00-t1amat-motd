#!/usr/bin/env bash
set -u

MOTD_DIR="${MOTD_DIR:-/etc/update-motd.d}"
CONFIG_FILE="${MOTD_CONFIG_FILE:-/etc/t1amat-motd.conf}"

if [[ -r "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

MOTD_ORDER_DEFAULT=(
    last-login
    uptime
    load-average
    memory
    disk-usage
    logins
    processes
    services
    docker
)

if ! declare -p MOTD_ORDER >/dev/null 2>&1; then
    MOTD_ORDER=("${MOTD_ORDER_DEFAULT[@]}")
fi

if ! declare -p MOTD_DISABLED >/dev/null 2>&1; then
    MOTD_DISABLED=()
fi

module_disabled() {
    local needle="$1" item
    for item in "${MOTD_DISABLED[@]}"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

module_file() {
    case "$1" in
        last-login) echo "$MOTD_DIR/01-last-login" ;;
        uptime) echo "$MOTD_DIR/03-uptime" ;;
        load-average) echo "$MOTD_DIR/04-load-average" ;;
        memory) echo "$MOTD_DIR/05-memory" ;;
        disk-usage) echo "$MOTD_DIR/06-disk-usage" ;;
        logins) echo "$MOTD_DIR/07-logins" ;;
        processes) echo "$MOTD_DIR/08-processes" ;;
        services) echo "$MOTD_DIR/09-services" ;;
        docker) echo "$MOTD_DIR/10-docker" ;;
        *) echo "$MOTD_DIR/$1" ;;
    esac
}

for module in "${MOTD_ORDER[@]}"; do
    module_disabled "$module" && continue

    file="$(module_file "$module")"
    [[ -f "$file" ]] || continue
    [[ "$file" == "$MOTD_DIR/00-t1amat-motd" ]] && continue
    [[ "$file" == "$MOTD_DIR/00-header" ]] && continue

    bash "$file" || true
 done

# Keep the shell prompt visually separated from the MOTD.
echo
exit 0
