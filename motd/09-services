#!/usr/bin/env bash
set -u

COLORS_FILE="${MOTD_COLORS_FILE:-/etc/update-motd.d/colors.txt}"
CONFIG_FILE="${MOTD_CONFIG_FILE:-/etc/t1amat-motd.conf}"

# shellcheck source=/dev/null
[[ -r "$COLORS_FILE" ]] && source "$COLORS_FILE"
# shellcheck source=/dev/null
[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

if ! declare -p MOTD_SERVICES >/dev/null 2>&1; then
    MOTD_SERVICES=(ssh ufw docker nginx)
fi

GREEN_COLOR="${GREEN_COLOR:-${CO:-\e[32m}}"
RED_COLOR="${RED_COLOR:-${CE:-\e[31m}}"
NC_COLOR="${NC_COLOR:-${CN:-\e[0m}}"

strip_ansi() {
    printf '%b\n' "$1" | sed -r 's/\x1B\[[0-9;?]*[ -\/]*[@-~]//g'
}

service_label() {
    case "$1" in
        ssh|sshd) echo "SSH" ;;
        ufw) echo "UFW" ;;
        docker) echo "Docker" ;;
        nginx) echo "nginx" ;;
        caddy) echo "Caddy" ;;
        fail2ban) echo "Fail2ban" ;;
        xray) echo "Xray" ;;
        unbound) echo "Unbound" ;;
        haproxy) echo "HAProxy" ;;
        keepalived) echo "Keepalived" ;;
        etcd) echo "etcd" ;;
        kubelet) echo "kubelet" ;;
        postgresql) echo "PostgreSQL" ;;
        redis-server) echo "Redis" ;;
        kafka) echo "Kafka" ;;
        patroni) echo "Patroni" ;;
        remnanode) echo "RemnaNode" ;;
        remnawave) echo "Remnawave" ;;
        dozzle-agent) echo "Dozzle Agent" ;;
        beszel-agent) echo "Beszel Agent" ;;
        *) echo "$1" ;;
    esac
}

service_exists() {
    local service="$1"

    case "$service" in
        ufw)
            command -v ufw >/dev/null 2>&1
            ;;
        docker)
            command -v docker >/dev/null 2>&1 ||
                systemctl cat docker.service >/dev/null 2>&1
            ;;
        ssh)
            systemctl cat ssh.service >/dev/null 2>&1 ||
                systemctl cat sshd.service >/dev/null 2>&1
            ;;
        *)
            systemctl cat "${service}.service" >/dev/null 2>&1
            ;;
    esac
}

get_state() {
    local service="$1"

    if [[ "$service" == "ufw" ]] && command -v ufw >/dev/null 2>&1; then
        if timeout 2 ufw status 2>/dev/null | grep -q '^Status: active'; then
            echo active
        else
            echo inactive
        fi
        return 0
    fi

    command -v systemctl >/dev/null 2>&1 || return 1

    case "$service" in
        ssh)
            if systemctl cat ssh.service >/dev/null 2>&1; then
                systemctl show -p ActiveState --value ssh.service 2>/dev/null
            else
                systemctl show -p ActiveState --value sshd.service 2>/dev/null
            fi
            ;;
        *)
            systemctl show -p ActiveState --value "${service}.service" 2>/dev/null
            ;;
    esac
}

term_width() {
    local width="${SERVICES_WIDTH:-0}"

    if [[ "$width" =~ ^[0-9]+$ ]] && (( width >= 40 )); then
        echo "$width"
        return
    fi

    if command -v tput >/dev/null 2>&1; then
        width="$(tput cols 2>/dev/null || true)"
    fi

    if ! [[ "$width" =~ ^[0-9]+$ ]] || (( width < 40 )); then
        width=78
    fi

    echo "$width"
}

status_text() {
    local label="$1" state="$2"

    if [[ "$state" == "active" ]]; then
        printf '%b▲%b %s' "$GREEN_COLOR" "$NC_COLOR" "$label"
    else
        printf '%b▼%b %s' "$RED_COLOR" "$NC_COLOR" "$label"
    fi
}

statuses=()
for service in "${MOTD_SERVICES[@]}"; do
    [[ -n "$service" ]] || continue
    service_exists "$service" || continue

    state="$(get_state "$service" || true)"
    [[ "$state" == active || "$state" == inactive ]] || continue

    label="$(service_label "$service")"
    statuses+=("$(status_text "$label" "$state")")
done

((${#statuses[@]} > 0)) || exit 0

prefix=" Services............:"
plain_prefix="$(strip_ansi "$prefix")"
prefix_len=${#plain_prefix}
width="$(term_width)"
available=$(( width - prefix_len - 1 ))

(( available < 20 )) && available=20

line="$prefix"
line_len=$prefix_len
first=1
continuation="$(printf '%*s' "$prefix_len" '')"

for status in "${statuses[@]}"; do
    visible="$(strip_ansi "$status")"
    separator=3

    if (( first )); then
        separator=1
    fi

    candidate_len=$(( line_len + separator + ${#visible} ))

    if (( !first && candidate_len > width )); then
        printf '%b\n' "$line"
        line="$continuation"
        line_len=$prefix_len
        first=1
        separator=1
    fi

    if (( !first )); then
        line+=" | "
        line_len=$(( line_len + 3 ))
    fi

    line+="$status"
    line_len=$(( line_len + ${#visible} ))
    first=0
done

printf '%b\n' "$line"
