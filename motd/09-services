#!/usr/bin/env bash
set -euo pipefail

COLORS_FILE="${MOTD_COLORS_FILE:-/etc/update-motd.d/colors.txt}"
CONFIG_FILE="${MOTD_CONFIG_FILE:-/etc/t1amat-motd.conf}"

# shellcheck source=/dev/null
[[ -r "$COLORS_FILE" ]] && source "$COLORS_FILE"
# shellcheck source=/dev/null
[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

if ! declare -p MOTD_SERVICES >/dev/null 2>&1; then
    MOTD_SERVICES=(ssh ufw docker nginx)
fi
SERVICES_WIDTH="${SERVICES_WIDTH:-78}"

GREEN_COLOR="${GREEN_COLOR:-${CO:-\e[32m}}"
RED_COLOR="${RED_COLOR:-${CE:-\e[31m}}"
NC_COLOR="${NC_COLOR:-${CN:-\e[0m}}"

strip_ansi() {
    printf '%b\n' "$1" | sed -r 's/\x1B\[[0-9;?]*[ -\/]*[@-~]//g'
}

service_label() {
    case "$1" in
        ssh|sshd) echo "SSH" ;;
        ufw) echo "UFW" ;;
        docker) echo "Docker" ;;
        nginx) echo "nginx" ;;
        caddy) echo "Caddy" ;;
        vnstat) echo "vnStat" ;;
        marzban) echo "Marzban" ;;
        *) echo "$1" ;;
    esac
}

print_status() {
    local label="$1"
    local state="$2"

    if [[ "$state" == "active" ]]; then
        printf '%b▲%b %s - active' "$GREEN_COLOR" "$NC_COLOR" "$label"
    else
        printf '%b▼%b %s - inactive' "$RED_COLOR" "$NC_COLOR" "$label"
    fi
}

get_status() {
    local service="$1"

    if [[ "$service" == *.service ]]; then
        service="${service%.service}"
    fi

    if [[ "$service" == "ufw" ]] && command -v ufw >/dev/null 2>&1; then
        if timeout 2 ufw status 2>/dev/null | grep -q '^Status: active'; then
            echo active
        else
            echo inactive
        fi
        return 0
    fi

    if ! command -v systemctl >/dev/null 2>&1; then
        return 1
    fi

    if ! systemctl cat "${service}.service" >/dev/null 2>&1; then
        return 1
    fi

    systemctl show -p ActiveState --value "${service}.service" 2>/dev/null || return 1
}

statuses=()
for service in "${MOTD_SERVICES[@]}"; do
    [[ -n "$service" ]] || continue
    state="$(get_status "$service" || true)"
    [[ "$state" == "active" || "$state" == "inactive" ]] || continue
    label="$(service_label "$service")"
    statuses+=("$(print_status "$label" "$state")")
done

((${#statuses[@]} > 0)) || exit 0

prefix=" Services............:"
prefix_visible="$(strip_ansi "$prefix")"
prefix_len=${#prefix_visible}
continuation="$(printf '%*s' "$((prefix_len + 1))" '')"

line="$prefix"
line_len=$prefix_len
first=1
for status in "${statuses[@]}"; do
    visible="$(strip_ansi "$status")"
    if (( first )); then
        candidate_len=$((line_len + 1 + ${#visible}))
        first=0
    else
        candidate_len=$((line_len + 3 + ${#visible}))
    fi

    if [[ "$first" -eq 0 && $candidate_len -gt $SERVICES_WIDTH ]]; then
        printf '%b\n' "$line"
        line="${continuation}${status}"
        line_len=$((prefix_len + 1 + ${#visible}))
    elif [[ "$line" == "$prefix" ]]; then
        line="${prefix} ${status}"
        line_len=$candidate_len
    else
        line="${line} | ${status}"
        line_len=$candidate_len
    fi
done

printf '%b\n' "$line"
